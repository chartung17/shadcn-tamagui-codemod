{
  "name": "shadcn-tamagui-codemod",
  "version": "0.1.0",
  "description": "Codemod that rewrites Tailwind/shadcn React components into Tamagui v3 components for web and native",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chartung17/shadcn-tamagui-codemod.git"
  },
  "homepage": "https://github.com/chartung17/shadcn-tamagui-codemod#readme",
  "bugs": {
    "url": "https://github.com/chartung17/shadcn-tamagui-codemod/issues"
  },
  "keywords": [
    "codemod",
    "shadcn",
    "shadcn-ui",
    "tamagui",
    "tailwind",
    "react-native",
    "expo"
  ],
  "type": "module",
  "bin": {
    "shadcn-tamagui-codemod": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm typecheck:fixtures && pnpm lint && pnpm format:check && pnpm test",
    "generate:data": "node scripts/generate-data.ts",
    "typecheck:fixtures": "tsc -p fixtures/tsconfig.typecheck.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "pnpm check && pnpm clean && pnpm build"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.10",
    "tinyglobby": "^0.2.17",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tamagui/config": "3.1.3",
    "@tamagui/core": "3.1.3",
    "@tamagui/dom": "3.1.3",
    "@tamagui/helpers-icon": "3.1.3",
    "@tamagui/style-grammar": "3.1.3",
    "@tamagui/tailwind": "3.1.3",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "~0.5.0",
    "eslint": "^10.13.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "~0.21.4",
    "tamagui": "3.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
