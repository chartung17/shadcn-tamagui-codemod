    "@tamagui/native": "3.1.3",
    "@tamagui/tailwind": "3.1.3",
    "class-variance-authority": "^0.7.1",
    "cn": "~0.5.0",
    "expo": "~58.0.19",
    "lucide-react": "^1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
