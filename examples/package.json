{
  "name": "shadcn-tamagui-codemod-examples",
  "private": true,
  "version": "0.0.0",
  "main": "index.ts",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev:original": "vite original",
    "dev:web": "vite converted",
    "build": "npm run build:original && npm run build:web",
    "build:original": "vite build original",
    "build:web": "vite build converted",
    "export:native": "expo export --platform ios --platform android --output-dir dist-native",
    "screenshots": "node scripts/screenshots.mjs",
    "typecheck": "tsc -p original && tsc -p converted",
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android"
  },
  "dependencies": {
